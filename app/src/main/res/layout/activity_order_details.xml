<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/greyFinal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.OrderDetailsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="8dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/backImg"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_back_with_bg"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/orderIdTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#ORD0000001"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@id/backImg"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/orderStatusTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_rounded_rect_20"
                android:backgroundTint="@color/orange"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolBar"
        app:layout_constraintBottom_toTopOf="@+id/submitConstraint">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/statusLinear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:background="@color/white"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEW"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:background="@drawable/bg_rounded_rect_20"
                        android:backgroundTint="@color/green"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash On Delivery"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:background="@drawable/bg_rounded_rect_20"
                        android:backgroundTint="@color/green"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginStart="12dp"/>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@id/statusLinear"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:layout_marginBottom="8dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/mapMainCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:cardCornerRadius="12dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/bg_rounded_rect_20"
                            android:backgroundTint="@color/white"
                            app:layout_constraintTop_toTopOf="parent">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="8dp">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/topConstraint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/durationTxt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Duration : 0 Mins"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/orange"
                                        android:paddingStart="12dp"
                                        android:paddingEnd="12dp"
                                        android:paddingTop="8dp"
                                        android:paddingBottom="8dp"
                                        android:layout_marginTop="10dp"
                                        android:background="@drawable/bg_left_round_rect_24"
                                        android:backgroundTint="@color/greyFinal"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"/>

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/distanceTxt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Distance : 0 M"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/orange"
                                        android:paddingStart="12dp"
                                        android:paddingEnd="12dp"
                                        android:paddingTop="8dp"
                                        android:paddingBottom="8dp"
                                        android:layout_marginTop="10dp"
                                        android:background="@drawable/bg_right_round_rect_24"
                                        android:backgroundTint="@color/greyFinal"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"/>

                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/shimmerCard"
                                    android:layout_width="match_parent"
                                    android:layout_height="200dp"
                                    app:cardCornerRadius="20dp"
                                    android:translationZ="10dp"
                                    android:layout_marginTop="16dp"
                                    app:layout_constraintTop_toBottomOf="@+id/topConstraint">

                                    <com.facebook.shimmer.ShimmerFrameLayout
                                        android:id="@+id/mapShimmerLayout"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:orientation="vertical"
                                        app:layout_constraintTop_toTopOf="parent">

                                        <androidx.appcompat.widget.LinearLayoutCompat
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:orientation="vertical"
                                            android:background="@color/black"/>

                                    </com.facebook.shimmer.ShimmerFrameLayout>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/mapCard"
                                    android:layout_width="match_parent"
                                    android:layout_height="200dp"
                                    app:cardCornerRadius="20dp"
                                    android:layout_marginTop="16dp"
                                    android:visibility="invisible"
                                    app:layout_constraintTop_toBottomOf="@+id/topConstraint">

                                    <androidx.fragment.app.FragmentContainerView
                                        android:id="@+id/map"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent" />

                                </androidx.cardview.widget.CardView>

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:id="@+id/naviBtn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingTop="12dp"
                                    android:paddingBottom="12dp"
                                    android:layout_marginTop="12dp"
                                    android:gravity="center"
                                    android:background="@drawable/bg_rounded_rect_20"
                                    android:backgroundTint="@color/greyFinal"
                                    app:layout_constraintTop_toBottomOf="@id/mapCard">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        app:srcCompat="@drawable/ic_route"
                                        android:layout_gravity="center"/>

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Navigate to Address"
                                        android:textColor="@color/black"
                                        android:layout_gravity="center"
                                        android:layout_marginStart="8dp"/>

                                </androidx.appcompat.widget.LinearLayoutCompat>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/customerInfoCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="12dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="4dp"
                            app:cardBackgroundColor="@color/white"
                            app:layout_constraintTop_toBottomOf="@+id/mapMainCard">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/customerTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Customer Information"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    android:textSize="15sp"
                                    app:layout_constraintTop_toTopOf="parent"/>

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/customerConstraint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    app:layout_constraintTop_toBottomOf="@+id/customerTitle">

                                    <de.hdodenhof.circleimageview.CircleImageView
                                        android:id="@+id/customerImg"
                                        android:layout_width="50dp"
                                        android:layout_height="50dp"
                                        android:src="@drawable/profile"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"/>

                                    <androidx.appcompat.widget.LinearLayoutCompat
                                        android:id="@+id/nameLinear"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:layout_marginStart="12dp"
                                        android:layout_marginEnd="12dp"
                                        app:layout_constraintStart_toEndOf="@+id/customerImg"
                                        app:layout_constraintEnd_toStartOf="@+id/customerCallImg"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent">

                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@+id/customerNameTxt"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="Jagathees JK"
                                            android:textColor="@color/black"
                                            android:textStyle="bold"
                                            app:layout_constraintTop_toTopOf="parent"/>

                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@+id/customerMbleTxt"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="Delivery - 1234567890"
                                            android:textColor="@color/grey_1"
                                            android:textSize="12sp"
                                            android:layout_marginTop="4dp"
                                            app:layout_constraintTop_toTopOf="parent"/>

                                    </androidx.appcompat.widget.LinearLayoutCompat>

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/customerCallImg"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        app:srcCompat="@drawable/ic_mobile"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"/>

                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <View
                                    android:id="@+id/detailsView"
                                    android:layout_width="match_parent"
                                    android:layout_height="3dp"
                                    android:background="@color/greyFinal"
                                    android:layout_marginTop="12dp"
                                    app:layout_constraintTop_toBottomOf="@+id/customerConstraint"/>

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/deliveryTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Delivery Details"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    android:textSize="15sp"
                                    android:visibility="gone"
                                    android:layout_marginTop="12dp"
                                    app:layout_constraintTop_toBottomOf="@id/detailsView"/>

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    app:layout_constraintTop_toBottomOf="@+id/deliveryTitle">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/deliveryImg"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        app:srcCompat="@drawable/ic_location"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"/>

                                    <androidx.appcompat.widget.LinearLayoutCompat
                                        android:id="@+id/deliveryLinear"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:layout_marginStart="12dp"
                                        android:layout_marginEnd="12dp"
                                        app:layout_constraintStart_toEndOf="@+id/deliveryImg"
                                        app:layout_constraintEnd_toStartOf="@+id/deliveryCpyImg"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent">

                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@+id/deliveryNameTxt"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="Delivery to"
                                            android:textColor="@color/black"
                                            android:textStyle="bold"
                                            app:layout_constraintTop_toTopOf="parent"/>

                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@+id/deliveryAddressTxt"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="37, Pattalathar street, amman nagar, komarapalayam, 638183"
                                            android:textColor="@color/grey_1"
                                            android:textSize="12sp"
                                            android:layout_marginTop="4dp"
                                            app:layout_constraintTop_toTopOf="parent"/>

                                    </androidx.appcompat.widget.LinearLayoutCompat>

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/deliveryCpyImg"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        app:srcCompat="@drawable/ic_mobile"
                                        android:visibility="gone"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"/>

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/deliveryBoyInfoCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="12dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="4dp"
                            app:cardBackgroundColor="@color/white"
                            app:layout_constraintTop_toBottomOf="@+id/customerInfoCard">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/deliveryBoyContraint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/deliveryBoyTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="DeliveryBoy Information"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    android:textSize="15sp"
                                    app:layout_constraintTop_toTopOf="parent"/>

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/deliveryBoyConstraint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    app:layout_constraintTop_toBottomOf="@+id/deliveryBoyTitle">

                                    <de.hdodenhof.circleimageview.CircleImageView
                                        android:id="@+id/deliveryBoyImg"
                                        android:layout_width="50dp"
                                        android:layout_height="50dp"
                                        android:src="@drawable/profile"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"/>

                                    <androidx.appcompat.widget.LinearLayoutCompat
                                        android:id="@+id/deliveryBoyNameLinear"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:layout_marginStart="12dp"
                                        android:layout_marginEnd="12dp"
                                        app:layout_constraintStart_toEndOf="@+id/deliveryBoyImg"
                                        app:layout_constraintEnd_toStartOf="@+id/deliveryBoyCallImg"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent">

                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@+id/deliveryBoyNameTxt"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="Jagathees JK"
                                            android:textColor="@color/black"
                                            android:textStyle="bold"
                                            app:layout_constraintTop_toTopOf="parent"/>

                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@+id/deliveryBoyMbleTxt"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="Delivery - 1234567890"
                                            android:textColor="@color/grey_1"
                                            android:textSize="12sp"
                                            android:layout_marginTop="4dp"
                                            app:layout_constraintTop_toTopOf="parent"/>

                                    </androidx.appcompat.widget.LinearLayoutCompat>

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/deliveryBoyCallImg"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:visibility="gone"
                                        app:srcCompat="@drawable/ic_mobile"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"/>

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/summaryCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="12dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="8dp"
                            app:cardBackgroundColor="@color/white"
                            app:layout_constraintTop_toBottomOf="@id/deliveryBoyInfoCard"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/summaryTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Order Summary"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    app:layout_constraintTop_toTopOf="parent"/>

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/summaryRecycler"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="6dp"
                                    tools:listitem="@layout/item_summary_layout"
                                    tools:itemCount="2"
                                    app:layout_constraintTop_toBottomOf="@+id/summaryTitle"/>

                                <View
                                    android:id="@+id/view"
                                    android:layout_width="match_parent"
                                    android:layout_height="2dp"
                                    android:background="@color/grey10"
                                    android:layout_marginTop="8dp"
                                    app:layout_constraintTop_toBottomOf="@+id/summaryRecycler"/>

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:orientation="horizontal"
                                    app:layout_constraintTop_toBottomOf="@+id/view">

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/totalTitleTxt"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:text="Total"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintEnd_toStartOf="@+id/totalTxt"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"/>

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/totalTxt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="₹400"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/green"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"/>

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.cardview.widget.CardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.core.widget.NestedScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/submitConstraint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/orderStatusBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mark as Picked up"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:layout_margin="8dp"
            android:background="@drawable/bg_rounded_rect_20"
            android:backgroundTint="@color/red"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
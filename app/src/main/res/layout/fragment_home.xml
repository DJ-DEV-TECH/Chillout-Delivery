                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed Deliveries"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="6dp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topConstraint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topCardConstraint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/bg_rounded_rect_20"
                android:backgroundTint="@color/orange"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/todayEarningTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Earnings"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/todayEarningAmountTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹500.00"
                    android:textSize="26sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/todayEarningTxt"
                    app:layout_constraintBottom_toTopOf="@+id/viewMoreTxt"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/viewMoreTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="view more"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/topCardConstraint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/topCardConstraint"
                app:srcCompat="@drawable/scooter"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/orderConstraint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="@drawable/bg_rounded_rect_20"
            android:backgroundTint="@color/purple"
            app:layout_constraintTop_toBottomOf="@id/topConstraint">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/newOrderTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New Delivery Orders Found!"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/seeMoreTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="view more"
                android:textColor="@color/orange"
                android:textAlignment="center"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toBottomOf="@+id/newOrderTxt"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            tools:listitem="@layout/item_new_order_layout"
            app:layout_constraintTop_toBottomOf="@id/orderConstraint"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
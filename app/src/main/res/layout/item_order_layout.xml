<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="12dp"
    android:layout_margin="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleConstraint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/itemOrderIDTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="#ORD-12345"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/itemOrderTimeTxt"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/itemOrderTimeTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 mins ago"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/greyFinal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/titleConstraint"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/itemAddressTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="34, Pattalathar street, amman nagar, komarapalayam"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/view"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/itemShopNameTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chillout Spot"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/itemAddressTxt"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/itemShopNameTxt"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending Acceptance"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_rounded_rect_20"
                android:backgroundTint="@color/greyFinal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accept Order"
                android:textColor="@color/white"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_rounded_rect_20"
                android:backgroundTint="@color/green"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
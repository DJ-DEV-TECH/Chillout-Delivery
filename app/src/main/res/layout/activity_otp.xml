<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.OtpActivity">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vectorImg"
        android:layout_width="240dp"
        android:layout_height="240dp"
        app:srcCompat="@drawable/scooter_vector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/labelConstraint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/vectorImg"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/createTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OTP Verification"
            android:textSize="28dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/DescTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the verification code we send you on : \n+91 7904340770"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/createTxt"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/uiOtpRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="7dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/DescTxt">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/uiOtpOneEd"
                style="@style/OtpBoxStyle"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/uiOtpTwoEd"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/uiOtpTwoEd"
                style="@style/OtpBoxStyle"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/uiOtpThreeEd"
                app:layout_constraintStart_toEndOf="@id/uiOtpOneEd"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/uiOtpThreeEd"
                style="@style/OtpBoxStyle"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/uiOtpFourEd"
                app:layout_constraintStart_toEndOf="@id/uiOtpTwoEd"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/uiOtpFourEd"
                style="@style/OtpBoxStyle"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/uiOtpFiveEd"
                app:layout_constraintStart_toEndOf="@id/uiOtpThreeEd"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/uiOtpFiveEd"
                style="@style/OtpBoxStyle"
                android:visibility="gone"
                android:layout_marginHorizontal="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/uiOtpSixEd"
                app:layout_constraintStart_toEndOf="@id/uiOtpFourEd"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/uiOtpSixEd"
                style="@style/OtpBoxStyle"
                android:visibility="gone"
                android:layout_marginHorizontal="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/uiOtpFiveEd"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/resendTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resend_text"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/uiOtpRow"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/timerLinear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/resendTxt">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ic_clock"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/timerTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:layout_marginStart="6dp"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.app.chillout_delivery.utils.RippleView
            android:id="@+id/rippleSendOtpBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:splitMotionEvents="false"
            app:rv_centered="@bool/rippleValueCentered"
            app:rv_color="@color/rippleValueColor_pink"
            app:rv_rippleDuration="@integer/rippleValueDuration"
            app:rv_type="simpleRipple"
            app:rv_zoom="@bool/rippleValueZoom"
            app:rv_zoomDuration="@integer/rippleValueZoomDuration"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/timerLinear">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/createBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sumbit"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_button_gradient_24" />

        </com.app.chillout_delivery.utils.RippleView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy"
            android:textSize="11sp"
            android:layout_marginStart="12sp"
            android:layout_marginEnd="12sp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@+id/rippleSendOtpBtn"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>